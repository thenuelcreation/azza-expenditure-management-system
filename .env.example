PORT=4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/azza_expenditure?schema=public"
CLIENT_ORIGIN=http://localhost:5173

# SMTP provider settings. For Gmail, use an app password rather than your login password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email@example.com

# Gmail OAuth settings. Create a Web application OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/email/google/callback
